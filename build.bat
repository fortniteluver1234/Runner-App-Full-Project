@echo off
setlocal DisableDelayedExpansion
setlocal EnableExtensions



pushd "%~dp0" || exit /b 1
set "MVNW=mvnw.cmd"

SET "CMD=%~1"
if "%CMD%"=="" (
  echo No target selected: building a LOCAL JAR. For a cloud build, run .\build.bat javascript_cloud.
  set CMD=jar
)
REM --- build progress reporting -----------------------------------------------
REM This project was generated by the Codename One Initializr. When you run this
REM launcher it tells cloud.codenameone.com that a build started and how Maven
REM exited, so a first build that dies on this machine (no JDK, an old JDK, a
REM Maven download, a compile error, a build that was never submitted) is visible
REM to us instead of silent, and we
REM can fix what trips people up.
REM
REM It sends ONLY: a one-way SHA-256 hash of this project's package name (never
REM the name itself), the target (e.g. javascript_cloud), "windows", the Java
REM major version, the exit code, one word for why the build stopped and how
REM many seconds it took. Never your code, paths, user name or build output.
REM Each report is a single request with a 3 second limit; a failure is ignored
REM and never changes the build's output or exit code.
REM
REM Opt out in Command Prompt:  set CN1_TELEMETRY=0
REM Opt out in PowerShell:      $Env:CN1_TELEMETRY = "0"
set "CN1_PROJECT_ID=2d70232083a77e773f3163ff3904bc664cec0d64b20fb772286d5b3d34faf367"
set "CN1_MIN_JAVA=17"
if not defined CN1_EVENTS_URL set "CN1_EVENTS_URL=https://cloud.codenameone.com/api/v2/funnel/initializr-event"
REM Maven reports IDE builds itself (cn1.telemetry.* in pom.xml); this tells it the
REM launcher is already reporting this one, so it is counted once.
set "CN1_LAUNCHER=1"
set "CN1_TARGET=%CMD%"
set "CN1_JAVA=none"
set "CN1_JAVA_EXE=java"
if defined JAVA_HOME set "CN1_JAVA_EXE=%JAVA_HOME%\bin\java"
for /f "tokens=3" %%v in ('call "%CN1_JAVA_EXE%" -version 2^>^&1 ^| findstr /i "version"') do set "CN1_JAVA=%%~v"
for /f "tokens=1,2 delims=." %%a in ("%CN1_JAVA%") do (
  if "%%a"=="1" (set "CN1_JAVA=%%b") else (set "CN1_JAVA=%%a")
)
REM A copy of Maven's output, read only for the one-word reason at exit (build.sh
REM does the same with tee). .mvn\Cn1Capture.java runs the Maven wrapper and
REM copies its output; it runs as a single source file, which needs Java 11 or
REM newer. With an older Java, no JDK, or reporting off, Maven runs exactly as
REM before and the reason comes from the Java check alone.
set "CN1_LOG="
REM A JRE runs java but has no javac, and Maven then fails with "No compiler is
REM provided". Known here without the output copy, which a Java 8 project's
REM JDK 8 cannot make, so it is reported as no_jdk either way.
set "CN1_JAVAC=yes"
if defined JAVA_HOME if not exist "%JAVA_HOME%\bin\javac.exe" set "CN1_JAVAC=no"
if not defined JAVA_HOME where javac >nul 2>&1 || set "CN1_JAVAC=no"
REM Copies left by builds that were interrupted (cmd cannot trap Ctrl+C, so
REM those never reach the cleanup at the end). A day old, so a build still
REM running in another window keeps its own.
if not "%CN1_TELEMETRY%"=="0" forfiles /p "%TEMP%" /m cn1-build-*.log /d -1 /c "cmd /c del /q @path" >nul 2>&1
set "CN1_JMAJ=0"
set /a CN1_JMAJ=%CN1_JAVA% >nul 2>&1
if not "%CN1_TELEMETRY%"=="0" if %CN1_JMAJ% GEQ 11 if exist "%~dp0.mvn\Cn1Capture.java" set "CN1_LOG=%TEMP%\cn1-build-%RANDOM%%RANDOM%.log"
if defined CN1_LOG set "MVNW=%~dp0.mvn\cn1-capture.cmd"
REM Start time as seconds since midnight, for the duration reported at exit.
REM Plain cmd arithmetic on %TIME%, deliberately not PowerShell: when the
REM launcher runs with redirected input (an IDE run configuration, CI) a
REM PowerShell child can wait on stdin forever and hang the whole build.
set "CN1_START="
if not "%CN1_TELEMETRY%"=="0" call :cn1_now
if not "%CN1_TELEMETRY%"=="0" set "CN1_START=%CN1_NOW%"
if /i not "%CMD%"=="help" call :cn1_event "step=launch" "exit=" "reason=" "secs="

goto %CMD%

goto :finish
:mac_desktop
call "%MVNW%" package -DskipTests -Dcodename1.platform^=javase -Dcodename1.buildTarget^=mac-os-x-desktop -U -e

goto :finish
:mac_native
call "%MVNW%" package -DskipTests -Dcodename1.platform^=ios -Dcodename1.buildTarget^=mac-os-x-native -U -e

goto :finish
:windows_desktop
call "%MVNW%" package -DskipTests -Dcodename1.platform^=javase -Dcodename1.buildTarget^=windows-desktop -U -e

goto :finish
:windows_device
call "%MVNW%" package -DskipTests -Dcodename1.platform^=win -Dcodename1.buildTarget^=windows-device -U -e

goto :finish
:uwp
goto :windows_device

:linux_device
call "%MVNW%" package -DskipTests -Dcodename1.platform^=linux -Dcodename1.buildTarget^=linux-device -U -e

goto :finish
:javascript
call "%MVNW%" package -DskipTests -Dcodename1.platform^=javascript -Dcodename1.buildTarget^=local-javascript -U -e

goto :finish
:javascript_cloud
call "%MVNW%" package -DskipTests -Dcodename1.platform^=javascript -Dcodename1.buildTarget^=javascript -U -e

goto :finish
:android
call "%MVNW%" package -DskipTests -Dcodename1.platform^=android -Dcodename1.buildTarget^=android-device -U -e

goto :finish
:xcode
call "%MVNW%" package -DskipTests -Dcodename1.platform^=ios -Dcodename1.buildTarget^=ios-source -U -e

goto :finish
:ios_source
goto :xcode

:android_source
call "%MVNW%" package -DskipTests -Dcodename1.platform^=android -Dcodename1.buildTarget^=android-source -U -e

goto :finish
:ios
call "%MVNW%" package -DskipTests -Dcodename1.platform^=ios -Dcodename1.buildTarget^=ios-device -U -e

goto :finish
:ios_release
call "%MVNW%" package -DskipTests -Dcodename1.platform^=ios -Dcodename1.buildTarget^=ios-device-release -U -e

goto :finish
:jar
call "%MVNW%" -Pexecutable-jar package -Dcodename1.platform^=javase -DskipTests -U -e

goto :finish
:help
echo .\build.bat [COMMAND]
echo Local Build Commands:
echo   The following commands will build the app locally ^(i.e. does NOT use the Codename One build server^)
echo 
echo   jar
echo     Builds app as desktop app executable jar file to javase/target directory
echo   android_source
echo     Generates an android gradle project that can be opened in Android studio
echo     *Requires android development tools installed.
echo     *Requires ANDROID_HOME environment variable
echo     *Requires either GRADLE_HOME environment variable^, or for gradle to be in PATH
echo   ios_source
echo     Generates an Xcode Project that you can open and build using Apple^'s development tools
echo     *Requires a Mac with Xcode installed
echo   javascript
echo     Builds the web app locally.
echo 
echo Build Server Commands:
echo   The following commands will build the app using the Codename One build server^, and require
echo   a Codename One account.  See https://www.codenameone.com
echo 
echo   ios
echo     Builds iOS app.
echo   ios_release
echo     Builds iOS app for submission to Apple appstore.
echo   android
echo     Builds android app.
echo   mac_desktop
echo     Builds Mac OS desktop app.
echo     *Mac OS Desktop builds are a Pro user feature.
echo   mac_native
echo     Builds a native Mac app ^(no JVM^).
echo   windows_desktop
echo     Builds Windows desktop app.
echo     *Windows Desktop builds are a Pro user feature.
echo   windows_device
echo     Builds a native Windows app ^(no JVM^).
echo   linux_device
echo     Builds a native Linux app ^(ELF^, no JVM^).
echo   javascript_cloud
echo     Builds the web app using the build server.

goto :finish
:settings
call "%MVNW%" cn1:settings -U -e

:finish
set "CN1_EXIT_CODE=%errorlevel%"
REM Why it stopped: from the copy of Maven's output when there is one (see the
REM launch block), the same words build.sh reports; otherwise from what was
REM checked before the build -- no JDK, or one older than this project's Java
REM level -- and anything else is build_failed. cmd cannot trap Ctrl+C, so an
REM interrupted build sends no exit report.
set "CN1_REASON="
if defined CN1_LOG if exist "%CN1_LOG%" call :cn1_log_reason
if defined CN1_LOG del "%CN1_LOG%" >nul 2>&1
if defined CN1_REASON goto :cn1_report
set "CN1_REASON=build_failed"
if "%CN1_JAVAC%"=="no" set "CN1_REASON=no_jdk"
if "%CN1_JAVA%"=="none" set "CN1_REASON=no_jdk"
set "CN1_JMAJ=0"
set /a CN1_JMAJ=%CN1_JAVA% >nul 2>&1
if not "%CN1_JAVA%"=="none" if %CN1_JMAJ% GTR 0 if %CN1_JMAJ% LSS %CN1_MIN_JAVA% set "CN1_REASON=java_too_old"
REM A clean exit with no copy of the output cannot be told from size_limit or
REM not_submitted, so it is not claimed as ok.
if "%CN1_EXIT_CODE%"=="0" set "CN1_REASON=unknown"
:cn1_report
set "CN1_SECS="
if defined CN1_START call :cn1_now
if defined CN1_START if defined CN1_NOW set /a "CN1_SECS=CN1_NOW-CN1_START"
if defined CN1_SECS if %CN1_SECS% LSS 0 set /a "CN1_SECS+=86400"
if /i not "%CN1_TARGET%"=="help" call :cn1_event "step=exit" "exit=%CN1_EXIT_CODE%" "reason=%CN1_REASON%" "secs=%CN1_SECS%"
popd
exit /b %CN1_EXIT_CODE%

REM Seconds since midnight from %TIME% (H:MM:SS.cc, or with a comma before the
REM hundredths in some locales). "1%%a-100" strips the leading zero that set /a
REM would otherwise read as octal; a leading space in the hour becomes a zero.
:cn1_now
set "CN1_NOW="
for /f "tokens=1-3 delims=:.," %%a in ("%TIME: =0%") do set /a "CN1_NOW=(1%%a-100)*3600+(1%%b-100)*60+(1%%c-100)" 2>nul
goto :eof

REM The reason from Maven's output, in build.sh's order (see cn1_reason there):
REM TLS before downloads, the build client's own refusals before a generic
REM failure. Leaves CN1_REASON unset when the output says nothing specific. A
REM clean exit is not always a submitted build: the free plan's size limit
REM returns normally, and so does a cloud build that never confirmed.
:cn1_log_reason
if not "%CN1_EXIT_CODE%"=="0" goto :cn1_log_failed
call :cn1_seen "Jar size limit reached" "Quota size limit reached" && set "CN1_REASON=size_limit" && goto :eof
call :cn1_seen "Your build was submitted" && set "CN1_REASON=ok" && goto :eof
call :cn1_seen "Sending build request to the server" && set "CN1_REASON=not_submitted" && goto :eof
set "CN1_REASON=ok"
goto :eof
:cn1_log_failed
call :cn1_seen "JAVA_HOME environment variable is not defined correctly" "java/javac command does not exist" "No compiler is provided in this environment" && set "CN1_REASON=no_jdk" && goto :eof
call :cn1_seen "invalid target release" "UnsupportedClassVersionError" "class file version" && set "CN1_REASON=java_too_old" && goto :eof
findstr /r /c:"release version [0-9]* not supported" "%CN1_LOG%" >nul 2>&1 && set "CN1_REASON=java_too_old" && goto :eof
call :cn1_seen "Browser login timed out" && set "CN1_REASON=login_timeout" && goto :eof
call :cn1_seen "Browser login failed" "Could not complete browser login" "Cannot authenticate a non-interactive build" "Account login failed" && set "CN1_REASON=login_failed" && goto :eof
call :cn1_seen "COMPILATION ERROR" && set "CN1_REASON=compile" && goto :eof
call :cn1_seen "PKIX path building failed" "unable to find valid certification path" "SSLHandshakeException" && set "CN1_REASON=tls" && goto :eof
call :cn1_seen "Could not resolve dependencies" "Could not transfer artifact" "Could not download" "Could not find artifact" "Could not resolve plugin" "PluginResolutionException" "Non-resolvable parent POM" "UnknownHostException" "Connection timed out" "Failed to fetch" && set "CN1_REASON=maven_download" && goto :eof
call :cn1_seen "Jar size limit reached" "Quota size limit reached" "exceeds 50MB in size" "exceeds 100MB in size" && set "CN1_REASON=size_limit" && goto :eof
call :cn1_seen "certificate from Apple with the appropriate password is required" "App id for an iOS build MUST be defined" "Error reading the certificate file" "Error reading the provisioning profile" && set "CN1_REASON=no_certificate" && goto :eof
call :cn1_seen "can't be empty" "The icon must be a 512x512" "Error reading the icon" && set "CN1_REASON=project_config" && goto :eof
call :cn1_seen "Error connecting to s3" "Failed to upload to server" "General network error occured" && set "CN1_REASON=upload_failed" && goto :eof
call :cn1_seen "Server Detailed Error Message" "Error! Server response code" && set "CN1_REASON=server_refused" && goto :eof
goto :eof

REM Whether the output copy contains any of the given strings (literal, case-sensitive).
:cn1_seen
set "CN1_FS="
:cn1_seen_next
if "%~1"=="" goto :cn1_seen_run
set CN1_FS=%CN1_FS% /c:"%~1"
shift
goto :cn1_seen_next
:cn1_seen_run
findstr %CN1_FS% "%CN1_LOG%" >nul 2>&1
exit /b %errorlevel%

REM Fire-and-forget: three seconds at most, and a failure is never an error.
:cn1_event
if "%CN1_TELEMETRY%"=="0" goto :eof
where curl.exe >nul 2>&1 || goto :eof
curl.exe -s -o nul -m 3 -X POST "%CN1_EVENTS_URL%" --data-urlencode "pkg=%CN1_PROJECT_ID%" --data-urlencode "target=%CN1_TARGET%" --data-urlencode "os=windows" --data-urlencode "java=%CN1_JAVA%" --data-urlencode %1 --data-urlencode %2 --data-urlencode %3 --data-urlencode %4 >nul 2>&1
goto :eof
